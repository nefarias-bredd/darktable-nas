#!/bin/bash
# darktable-nas - Launch darktable with NAS-based photo library
# https://github.com/karstenr/darktable-nas
#
# Features:
# - Syncs database locally for performance
# - Multi-machine locking prevents conflicts
# - Smart mount: local network first, Tailscale fallback
# - Proper config separation (local config never synced)

set -euo pipefail

VERSION="1.1.1"

# === DEFAULT CONFIGURATION ===
# These can be overridden in ~/.config/darktable-nas/darktable-nas.conf

NAS_HOST_LOCAL="${NAS_HOST_LOCAL:-192.168.1.100}"
NAS_HOST_TAILSCALE="${NAS_HOST_TAILSCALE:-100.100.100.100}"
NAS_SHARE="${NAS_SHARE:-/home}"
NAS_MOUNT="${NAS_MOUNT:-/mnt/synology}"
NAS_DB_PATH="${NAS_DB_PATH:-darktable-db}"
NAS_PHOTOS_PATH="${NAS_PHOTOS_PATH:-raws}"
NAS_JPEGS_SHARE="${NAS_JPEGS_SHARE:-/photo}"
NAS_JPEGS_MOUNT="${NAS_JPEGS_MOUNT:-/mnt/synology-photo}"

CIFS_CREDENTIALS="${CIFS_CREDENTIALS:-/etc/cifs-credentials/synology}"

LOCAL_DB_DIR="${LOCAL_DB_DIR:-$HOME/.local/share/darktable-nas}"
LOCAL_CONFIG_DIR="${LOCAL_CONFIG_DIR:-$HOME/.config/darktable-nas}"
LOCAL_CACHE_DIR="${LOCAL_CACHE_DIR:-$HOME/.cache/darktable}"

# Mount options
CIFS_OPTS_BASE="uid=$(id -u),gid=$(id -g),iocharset=utf8,vers=3.1.1,nobrl,cache=strict,rsize=130048,wsize=130048,_netdev"
CIFS_OPTS_LOCAL="actimeo=60,echo_interval=60"
CIFS_OPTS_TAILSCALE="actimeo=120,echo_interval=120"

# === RUNTIME STATE ===
NAS_DB_DIR=""
CONNECTION_TYPE=""
TAILSCALE_STARTED=false
DT_PID=""

# === COLORS ===
if [[ -t 1 ]]; then
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    RED='\033[0;31m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    GREEN='' YELLOW='' RED='' BLUE='' NC=''
fi

# === LOGGING ===
log_info()  { echo -e "${GREEN}[INFO]${NC} $*"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }
log_debug() { [[ "${DEBUG:-}" == "1" ]] && echo -e "${BLUE}[DEBUG]${NC} $*" || true; }

# === HELPER FUNCTIONS ===

show_help() {
    cat << EOF
darktable-nas v${VERSION} - Launch darktable with NAS-based photo library

Usage: darktable-nas [OPTIONS] [-- DARKTABLE_ARGS]

Options:
    -h, --help          Show this help message
    -v, --version       Show version
    -d, --debug         Enable debug output
    --status            Show connection status and exit
    --unlock            Force remove lock files and exit

Environment:
    Configuration is loaded from:
    ~/.config/darktable-nas/darktable-nas.conf

Examples:
    darktable-nas                    # Normal launch
    darktable-nas --status           # Check connection
    darktable-nas -- --help          # Pass --help to darktable
EOF
}

load_config() {
    local config_file="$LOCAL_CONFIG_DIR/darktable-nas.conf"
    if [[ -f "$config_file" ]]; then
        log_debug "Loading config from $config_file"
        # shellcheck source=/dev/null
        source "$config_file"
    else
        log_debug "No config file found, using defaults"
    fi

    # Set derived paths
    NAS_DB_DIR="$NAS_MOUNT/$NAS_DB_PATH"
}

# === TAILSCALE FUNCTIONS ===

start_tailscale() {
    if ! systemctl is-active --quiet tailscaled 2>/dev/null; then
        log_info "Starting Tailscale daemon..."
        if sudo systemctl start tailscaled; then
            TAILSCALE_STARTED=true
            sleep 2
            sudo tailscale up 2>/dev/null || true
            sleep 2
            log_info "Tailscale started"
        else
            log_warn "Failed to start Tailscale"
            return 1
        fi
    fi
    return 0
}

stop_tailscale() {
    if [[ "$TAILSCALE_STARTED" == true ]]; then
        log_info "Stopping Tailscale..."
        sudo tailscale down 2>/dev/null || true
        sudo systemctl stop tailscaled 2>/dev/null || true
    fi
}

# === MOUNT FUNCTIONS ===

is_mounted() {
    mountpoint -q "$NAS_MOUNT" 2>/dev/null
}

get_connection_type() {
    local ip
    ip=$(cat /var/run/darktable-nas-mount-ip 2>/dev/null || echo "")
    case "$ip" in
        "$NAS_HOST_LOCAL") echo "local" ;;
        "$NAS_HOST_TAILSCALE") echo "tailscale" ;;
        *) echo "unknown" ;;
    esac
}

mount_nas() {
    if is_mounted; then
        CONNECTION_TYPE=$(get_connection_type)
        log_info "NAS already mounted ($CONNECTION_TYPE)"
        return 0
    fi

    log_info "Mounting NAS..."
    sudo mkdir -p "$NAS_MOUNT"
    sudo mkdir -p "$NAS_JPEGS_MOUNT"

    # Try local network first
    log_debug "Trying local network mount ($NAS_HOST_LOCAL)..."
    local mount_opts="credentials=$CIFS_CREDENTIALS,$CIFS_OPTS_BASE,$CIFS_OPTS_LOCAL"

    if sudo mount -t cifs "//$NAS_HOST_LOCAL$NAS_SHARE" "$NAS_MOUNT" -o "$mount_opts" 2>/dev/null; then
        sudo mount -t cifs "//$NAS_HOST_LOCAL$NAS_JPEGS_SHARE" "$NAS_JPEGS_MOUNT" -o "$mount_opts" 2>/dev/null || \
            log_warn "Could not mount JPEG share ($NAS_JPEGS_SHARE) at $NAS_JPEGS_MOUNT"
        CONNECTION_TYPE="local"
        echo "$NAS_HOST_LOCAL" | sudo tee /var/run/darktable-nas-mount-ip > /dev/null
        log_info "Connected via local network"
        sleep 1
        return 0
    fi

    # Fall back to Tailscale
    log_info "Local network unavailable, trying Tailscale..."
    start_tailscale || true

    mount_opts="credentials=$CIFS_CREDENTIALS,$CIFS_OPTS_BASE,$CIFS_OPTS_TAILSCALE"

    if sudo mount -t cifs "//$NAS_HOST_TAILSCALE$NAS_SHARE" "$NAS_MOUNT" -o "$mount_opts" 2>/dev/null; then
        sudo mount -t cifs "//$NAS_HOST_TAILSCALE$NAS_JPEGS_SHARE" "$NAS_JPEGS_MOUNT" -o "$mount_opts" 2>/dev/null || \
            log_warn "Could not mount JPEG share ($NAS_JPEGS_SHARE) at $NAS_JPEGS_MOUNT"
        CONNECTION_TYPE="tailscale"
        echo "$NAS_HOST_TAILSCALE" | sudo tee /var/run/darktable-nas-mount-ip > /dev/null
        log_info "Connected via Tailscale"
        sleep 1
        return 0
    fi

    log_error "Failed to mount NAS"
    return 1
}

unmount_nas() {
    log_info "Unmounting NAS..."
    sync
    sleep 1
    sudo umount "$NAS_JPEGS_MOUNT" 2>/dev/null || true
    sudo umount "$NAS_MOUNT" 2>/dev/null || log_warn "Could not unmount cleanly"
    sudo rm -f /var/run/darktable-nas-mount-ip
}

# === LOCK FUNCTIONS ===

LOCKFILE=""
PIDFILE=""

init_lock_paths() {
    LOCKFILE="$NAS_DB_DIR/darktable.lock"
    PIDFILE="$NAS_DB_DIR/darktable.pid"
}

check_lock() {
    if [[ ! -f "$LOCKFILE" ]]; then
        return 0  # No lock exists
    fi

    local lock_info lock_host lock_pid
    lock_info=$(cat "$LOCKFILE" 2>/dev/null || echo "")
    lock_host=$(echo "$lock_info" | cut -d: -f1)
    lock_pid=$(cat "$PIDFILE" 2>/dev/null || echo "")

    # Check for stale lock from this machine
    if [[ "$lock_host" == "$(hostname)" ]]; then
        if [[ -n "$lock_pid" ]] && ! ps -p "$lock_pid" &>/dev/null; then
            log_warn "Removing stale lock from crashed session"
            rm -f "$LOCKFILE" "$PIDFILE"
            return 0
        fi
    fi

    log_error "Database is locked by: $lock_info"
    return 1
}

acquire_lock() {
    echo "$(hostname):$(whoami):$(date -Iseconds)" > "$LOCKFILE"
    echo $$ > "$PIDFILE"
    log_debug "Lock acquired"
}

release_lock() {
    rm -f "$LOCKFILE" "$PIDFILE"
    log_debug "Lock released"
}

force_unlock() {
    mount_nas || exit 1
    init_lock_paths

    if [[ -f "$LOCKFILE" ]]; then
        log_info "Lock info: $(cat "$LOCKFILE")"
        rm -f "$LOCKFILE" "$PIDFILE"
        log_info "Lock removed"
    else
        log_info "No lock file found"
    fi
}

# === DATABASE SYNC FUNCTIONS ===

sync_from_nas() {
    log_info "Syncing database from NAS..."
    mkdir -p "$LOCAL_DB_DIR"

    # Record NAS modification time for conflict detection
    if [[ -f "$NAS_DB_DIR/library.db" ]]; then
        stat -c %Y "$NAS_DB_DIR/library.db" > "$LOCAL_DB_DIR/.nas_sync_time" 2>/dev/null || true
    fi

    # Sync ONLY database files (not config!)
    rsync -av \
        --include='library.db' \
        --include='library.db-wal' \
        --include='library.db-shm' \
        --include='data.db' \
        --include='data.db-wal' \
        --include='data.db-shm' \
        --exclude='*' \
        "$NAS_DB_DIR/" "$LOCAL_DB_DIR/" 2>&1 | grep -v "^$" || true

    if [[ -f "$LOCAL_DB_DIR/library.db" ]]; then
        local db_size
        db_size=$(du -h "$LOCAL_DB_DIR/library.db" | cut -f1)
        log_info "Database synced (library.db: $db_size)"
    else
        log_error "Failed to sync database"
        return 1
    fi
}

sync_to_nas() {
    log_info "Syncing database changes to NAS..."

    # Check for conflicts
    if [[ -f "$LOCAL_DB_DIR/.nas_sync_time" ]] && [[ -f "$NAS_DB_DIR/library.db" ]]; then
        local stored_time current_time
        stored_time=$(cat "$LOCAL_DB_DIR/.nas_sync_time" 2>/dev/null || echo "0")
        current_time=$(stat -c %Y "$NAS_DB_DIR/library.db" 2>/dev/null || echo "0")

        if [[ "$stored_time" != "$current_time" ]] && [[ "$stored_time" != "0" ]]; then
            log_warn "CONFLICT: NAS database was modified during this session!"
            local backup_file="$NAS_DB_DIR/library.db.conflict.$(date +%Y%m%d_%H%M%S)"
            cp "$NAS_DB_DIR/library.db" "$backup_file"
            log_warn "Created backup: $backup_file"
        fi
    fi

    # Sync database files back to NAS
    rsync -av \
        --include='library.db' \
        --include='library.db-wal' \
        --include='library.db-shm' \
        --include='data.db' \
        --include='data.db-wal' \
        --include='data.db-shm' \
        --exclude='*' \
        "$LOCAL_DB_DIR/" "$NAS_DB_DIR/" 2>&1 | grep -v "^$" || true

    log_info "Database synced to NAS"
}

# === CONFIG INITIALIZATION ===

init_local_config() {
    mkdir -p "$LOCAL_CONFIG_DIR"

    if [[ -f "$LOCAL_CONFIG_DIR/darktablerc" ]]; then
        log_debug "Local darktable config exists"
        # Ensure crawler is disabled (in case user enabled it)
        if grep -q "run_crawler_on_start=TRUE" "$LOCAL_CONFIG_DIR/darktablerc" 2>/dev/null; then
            sed -i 's/run_crawler_on_start=TRUE/run_crawler_on_start=FALSE/g' "$LOCAL_CONFIG_DIR/darktablerc"
            log_debug "Fixed run_crawler_on_start setting"
        fi
        return 0
    fi

    log_info "Initializing local darktable config..."

    # Check for template in package directory
    local template=""
    for path in \
        "/usr/share/darktable-nas/darktablerc.template" \
        "/usr/local/share/darktable-nas/darktablerc.template" \
        "$(dirname "$(readlink -f "$0")")/../config/darktablerc.template"
    do
        if [[ -f "$path" ]]; then
            template="$path"
            break
        fi
    done

    if [[ -n "$template" ]]; then
        # Use template and substitute variables
        sed -e "s|\${NAS_MOUNT}|$NAS_MOUNT|g" \
            -e "s|\${NAS_PHOTOS_PATH}|$NAS_PHOTOS_PATH|g" \
            "$template" > "$LOCAL_CONFIG_DIR/darktablerc"
    else
        # Create minimal config
        cat > "$LOCAL_CONFIG_DIR/darktablerc" << EOF
# darktable-nas local configuration
# This file is machine-specific and never synced to NAS

# CRITICAL: Disable slow XMP sidecar check on startup
run_crawler_on_start=FALSE

# Photo import paths (on NAS)
session/base_directory_pattern=$NAS_MOUNT/$NAS_PHOTOS_PATH
session/sub_directory_pattern=\$(EXIF.YEAR)/\$(EXIF.MONTH)/\$(EXIF.YEAR)-\$(EXIF.MONTH)-\$(EXIF.DAY)
session/filename_pattern=\$(EXIF.YEAR)\$(EXIF.MONTH)\$(EXIF.DAY)_\$(SEQUENCE).\$(FILE_EXTENSION)

# Database snapshots
database/create_snapshot=on close
database/keep_snapshots=10
EOF
    fi

    log_info "Created local config at $LOCAL_CONFIG_DIR/darktablerc"
}

# === THUMBNAIL CACHE ===

setup_thumbnail_cache() {
    # Calculate expected cache hash for local database path
    local local_db_path="$LOCAL_DB_DIR/library.db"
    local local_hash nas_hash
    local_hash=$(echo -n "$local_db_path" | sha1sum | cut -d' ' -f1)

    local local_cache_dir="$LOCAL_CACHE_DIR/mipmaps-${local_hash}.d"

    if [[ -d "$local_cache_dir" ]] && [[ "$(ls -A "$local_cache_dir" 2>/dev/null | wc -l)" -gt 0 ]]; then
        local cache_size
        cache_size=$(du -sh "$local_cache_dir" 2>/dev/null | cut -f1)
        log_info "Thumbnail cache ready ($cache_size)"
        return 0
    fi

    # Try to copy from NAS database cache
    local nas_db_path="$NAS_DB_DIR/library.db"
    nas_hash=$(echo -n "$nas_db_path" | sha1sum | cut -d' ' -f1)
    local nas_cache_dir="$LOCAL_CACHE_DIR/mipmaps-${nas_hash}.d"

    if [[ -d "$nas_cache_dir" ]] && [[ "$(ls -A "$nas_cache_dir" 2>/dev/null | wc -l)" -gt 0 ]]; then
        log_info "Copying thumbnail cache from previous install..."
        mkdir -p "$local_cache_dir"
        rsync -a "$nas_cache_dir/" "$local_cache_dir/" 2>/dev/null || true
        local cache_size
        cache_size=$(du -sh "$local_cache_dir" 2>/dev/null | cut -f1)
        log_info "Thumbnail cache ready ($cache_size)"
    else
        log_info "No existing thumbnail cache found (will be generated on first use)"
    fi
}

# === CLEANUP ===

cleanup() {
    local exit_code=$?

    log_info "Shutting down..."

    # Wait for darktable to exit
    if [[ -n "${DT_PID:-}" ]] && ps -p "$DT_PID" &>/dev/null; then
        log_info "Waiting for darktable to close..."
        kill -TERM "$DT_PID" 2>/dev/null || true

        for _ in {1..10}; do
            ps -p "$DT_PID" &>/dev/null || break
            sleep 1
        done

        if ps -p "$DT_PID" &>/dev/null; then
            log_warn "Force killing darktable..."
            kill -KILL "$DT_PID" 2>/dev/null || true
        fi
    fi

    # Flush writes
    sync
    sleep 1

    # Only sync/unmount if NAS is actually mounted
    if is_mounted; then
        # Sync database back to NAS
        if [[ -n "$NAS_DB_DIR" ]] && [[ -d "$NAS_DB_DIR" ]]; then
            sync_to_nas || log_warn "Database sync failed"
        fi

        # Release lock
        if [[ -n "$LOCKFILE" ]]; then
            release_lock
        fi

        # Unmount
        unmount_nas
    fi
    stop_tailscale

    exit $exit_code
}

# === STATUS ===

show_status() {
    echo "darktable-nas v${VERSION}"
    echo ""

    if is_mounted; then
        echo "NAS Mount:    CONNECTED ($(get_connection_type))"
        echo "Mount Point:  $NAS_MOUNT"
    else
        echo "NAS Mount:    NOT CONNECTED"
    fi

    echo ""
    echo "Paths:"
    echo "  NAS DB:     $NAS_MOUNT/$NAS_DB_PATH"
    echo "  Local DB:   $LOCAL_DB_DIR"
    echo "  Config:     $LOCAL_CONFIG_DIR"
    echo ""

    if [[ -f "$LOCAL_DB_DIR/library.db" ]]; then
        echo "Local Database: $(du -h "$LOCAL_DB_DIR/library.db" | cut -f1)"
    else
        echo "Local Database: Not synced"
    fi
}

# === MAIN ===

main() {
    # Parse arguments
    local dt_args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                echo "darktable-nas v${VERSION}"
                exit 0
                ;;
            -d|--debug)
                DEBUG=1
                shift
                ;;
            --status)
                load_config
                show_status
                exit 0
                ;;
            --unlock)
                load_config
                force_unlock
                exit 0
                ;;
            --)
                shift
                dt_args+=("$@")
                break
                ;;
            *)
                dt_args+=("$1")
                shift
                ;;
        esac
    done

    echo -e "${GREEN}=== darktable-nas v${VERSION} ===${NC}"

    # Load configuration
    load_config

    # Set up cleanup trap
    trap cleanup EXIT INT TERM

    # Mount NAS
    mount_nas || exit 1

    # Verify database directory exists
    if [[ ! -d "$NAS_DB_DIR" ]]; then
        log_error "NAS database directory not found: $NAS_DB_DIR"
        exit 1
    fi

    # Initialize lock paths and check/acquire lock
    init_lock_paths
    check_lock || exit 1
    acquire_lock

    # Sync database from NAS
    sync_from_nas || exit 1

    # Initialize local config
    init_local_config

    # Set up thumbnail cache
    setup_thumbnail_cache

    # Launch darktable
    log_info "Starting darktable..."
    export OMP_WAIT_POLICY=passive

    /usr/bin/darktable \
        --library "$LOCAL_DB_DIR/library.db" \
        --configdir "$LOCAL_CONFIG_DIR" \
        --conf run_crawler_on_start=FALSE \
        "${dt_args[@]}" &
    DT_PID=$!

    log_info "darktable started (PID: $DT_PID)"

    # Wait for darktable to exit
    wait $DT_PID 2>/dev/null || true
}

main "$@"
