# darktable-nas local configuration
# This file is machine-specific and NEVER synced to the NAS
#
# Generated by darktable-nas on first run
# You can customize these settings - they will be preserved across updates

# =============================================================================
# CRITICAL PERFORMANCE SETTINGS
# =============================================================================

# Disable XMP sidecar file check on startup (VERY slow over network)
run_crawler_on_start=FALSE

# =============================================================================
# PHOTO STORAGE PATHS
# =============================================================================

# Where new photos are imported to (on NAS)
session/base_directory_pattern=${NAS_MOUNT}/${NAS_PHOTOS_PATH}

# Subfolder structure for imported photos
session/sub_directory_pattern=$(EXIF.YEAR)/$(EXIF.MONTH)/$(EXIF.YEAR)-$(EXIF.MONTH)-$(EXIF.DAY)

# Filename pattern for imported photos
session/filename_pattern=$(EXIF.YEAR)$(EXIF.MONTH)$(EXIF.DAY)_$(SEQUENCE).$(FILE_EXTENSION)

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# Create database snapshots on close
database/create_snapshot=on close

# Number of snapshots to keep
database/keep_snapshots=10

# =============================================================================
# OPTIONAL: UNCOMMENT TO CUSTOMIZE
# =============================================================================

# Performance tuning (adjust for your hardware)
# resourcelevel=default
# cache_disk_backend=TRUE
# cache_disk_backend_full=FALSE

# OpenCL GPU acceleration (if available)
# opencl=TRUE

# UI theme
# ui_last/theme=darktable-elegant-grey
